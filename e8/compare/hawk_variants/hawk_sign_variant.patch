--- a/src/hawk_sign.c
+++ b/src/hawk_sign.c
@@ -1,4 +1,27 @@
+/*
+ * Derived from upstream hawk_sign.c, modified for benchmarking.
+ *
+ * Generated by e8/Makefile from ../src/hawk_sign.c and
+ * e8/compare/hawk_variants/hawk_sign_variant.patch; do not edit. This is
+ * upstream sign_finish_inner() with only the sampler call replaced: the
+ * SHAKE-mode sig_gauss() call goes through the hook
+ * hawk_variant_sampler() (hawk_variants.h), which receives upstream's
+ * already-absorbed hm || K || enc32le(attempt + 1) state. The public
+ * entry points are renamed (hawk_* -> hawkv_*) so that this file links
+ * beside the upstream hawk_sign.o / hawk_shim.o; HAWK_PREFIX is not used
+ * because it renames every Zh() symbol, including imported ones. Two
+ * entry points are added: hawkv_sign_finish_decoded() (decoded key, as
+ * hawk_shim_sign_finish_decoded()) and hawkv_sig_gauss() (this copy's
+ * unmodified sig_gauss()).
+ */
+
+#define hawk_sign_start           hawkv_sign_start
+#define hawk_sign_finish          hawkv_sign_finish
+#define hawk_sign_finish_alt      hawkv_sign_finish_alt
+#define hawk_decode_private_key   hawkv_decode_private_key
+
 #include "hawk_inner.h"
+#include "hawk_variants.h"
 
 /*
  * We use computations with polynomials modulo X^n+1 and modulo 18433.
@@ -1734,7 +1757,8 @@
 				shake_inject(&scd, priv, seed_len);
 			}
 			shake_inject(&scd, tbuf, sizeof tbuf);
-			xsn = sig_gauss(logn, rng, rng_context, &scd, x0, t0);
+			xsn = hawk_variant_sampler(logn,
+				rng, rng_context, &scd, x0, t0);
 		} else {
 			xsn = sig_gauss_alt(logn, rng, rng_context, x0, t0);
 		}
@@ -1976,3 +2000,26 @@
 	memmove(g + n, (const uint8_t *)priv + seed_len, (n >> 2) + hpub_len);
 	Hawk_regen_fg(logn, f, g, seed);
 }
+
+/* see hawk_variants.h */
+int
+hawkv_sign_finish_decoded(unsigned logn,
+	void (*rng)(void *ctx, void *dst, size_t len), void *rng_context,
+	void *sig, const shake_context *sc_data,
+	const void *priv_decoded, void *tmp, size_t tmp_len)
+{
+	if (logn < 8 || logn > 10) {
+		return 0;
+	}
+	return sign_finish_inner(logn, 1, rng, rng_context, sig, sc_data,
+		priv_decoded, HAWK_PRIVKEY_DECODED_SIZE(logn), tmp, tmp_len);
+}
+
+/* see hawk_variants.h */
+uint32_t
+hawkv_sig_gauss(unsigned logn,
+	void (*rng)(void *ctx, void *dst, size_t len), void *rng_context,
+	const shake_context *sc_extra, int8_t *x, const uint8_t *t)
+{
+	return sig_gauss(logn, rng, rng_context, sc_extra, x, t);
+}
