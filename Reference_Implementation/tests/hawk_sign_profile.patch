+	uint64_t wall_ns_sample;
+	uint64_t wall_ns_norm_check;
+	uint64_t wall_ns_reconstruct;
+	uint64_t wall_ns_symbreak;
+	uint64_t wall_ns_encode;
+	uint64_t attempts_total;
+	uint64_t norm_rejections;
+	uint64_t bound_rejections;
+	uint64_t encode_rejections;
+} hawk_sign_profile;
+
+static hawk_sign_profile hawk_sign_profile_current;
+static int hawk_sign_profile_current_valid;
+
+static uint64_t
+hawk_sign_profile_wall_ns(void)
+{
+	struct timespec ts;
+
+#if defined(CLOCK_MONOTONIC_RAW)
+	if (clock_gettime(CLOCK_MONOTONIC_RAW, &ts) != 0) {
+		return 0;
+	}
+#else
+	if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0) {
+		return 0;
+	}
+#endif
+	return (uint64_t)ts.tv_sec * UINT64_C(1000000000)
+		+ (uint64_t)ts.tv_nsec;
+}
+
+static uint64_t
+hawk_sign_profile_cycles_start(void)
+{
+#if defined(__x86_64__)
+	_mm_lfence();
+	return __rdtsc();
+#else
+	return 0;
+#endif
+}
+
+static uint64_t
+hawk_sign_profile_cycles_end(void)
+{
+#if defined(__x86_64__)
+	unsigned int aux;
+	uint64_t x;
+
+	x = __rdtscp(&aux);
+	_mm_lfence();
+	return x;
+#else
+	return 0;
+#endif
+}
+
+static uint64_t
+hawk_sign_profile_delta(uint64_t t0, uint64_t t1)
+{
+	if (t0 == 0 && t1 == 0) {
+		return 0;
+	}
+	if (t1 <= t0) {
+		return 1;
+	}
+	return t1 - t0;
+}
+
+static void
+hawk_sign_profile_reset(void)
+{
+	memset(&hawk_sign_profile_current, 0,
+		sizeof hawk_sign_profile_current);
+	hawk_sign_profile_current_valid = 0;
+}
+
+static int
+hawk_sign_profile_get(hawk_sign_profile *profile)
+{
+	if (profile == NULL || !hawk_sign_profile_current_valid) {
+		return 0;
+	}
+	*profile = hawk_sign_profile_current;
+	return 1;
+}
+
+static void
+hawk_sign_profile_stage_start(uint64_t *cycles_start,
+	uint64_t *wall_start)
+{
+	*cycles_start = hawk_sign_profile_cycles_start();
+	*wall_start = hawk_sign_profile_wall_ns();
+}
+
+static void
+hawk_sign_profile_stage_add(uint64_t *cycles_total,
+	uint64_t *wall_total, uint64_t cycles_start, uint64_t wall_start)
+{
+	uint64_t wall_end = hawk_sign_profile_wall_ns();
+	uint64_t cycles_end = hawk_sign_profile_cycles_end();
+
+	*cycles_total += hawk_sign_profile_delta(cycles_start, cycles_end);
+	*wall_total += hawk_sign_profile_delta(wall_start, wall_end);
+}
+
+static void
+hawk_sign_profile_finish(uint64_t cycles_start, uint64_t wall_start)
+{
+	if (cycles_start != 0 || wall_start != 0) {
+		uint64_t wall_end = hawk_sign_profile_wall_ns();
+		uint64_t cycles_end = hawk_sign_profile_cycles_end();
+
+		hawk_sign_profile_current.cycles_sign_total +=
+			hawk_sign_profile_delta(cycles_start, cycles_end);
+		hawk_sign_profile_current.wall_ns_sign_total +=
+			hawk_sign_profile_delta(wall_start, wall_end);
+		hawk_sign_profile_current_valid = 1;
+	}
+}
+#endif
